# spesaok – configurazione Apache (TopHost)
# Forza HTTPS (necessario per la PWA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType application/manifest+json .webmanifest
AddType application/json .json
AddType image/svg+xml .svg
AddDefaultCharset utf-8
AddCharset utf-8 .js .css .json .webmanifest

# Service worker, pagina e dati: sempre ricontrollati, così gli aggiornamenti arrivano subito
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html|offerte\.json|negozi\.json|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
